ADMIN_TOKEN=your-secret-token-here
CHENWEBSITE_URL=https://your-website.vercel.app
VITE_BLOG_URL=https://your-blog.vercel.app
# 开发服务器把 /api 代理到哪个后端；默认 http://localhost:3001。
# 3001 被占用时改这里，并让后端用 PORT 监听同一个端口。
# VITE_API_TARGET=http://localhost:3010
# 留空/不设置 → 本地 JSON 存储（server/data/*.json）+ public/uploads/
# 设置后本地会直接读写线上 Neon 库；想两者兼得就用 npm run dev:server:local
# DATABASE_URL=postgresql://...
